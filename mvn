#!/usr/bin/env bash
set -e

# =========================================================
# 1. AUTO-DETECT OR DOWNLOAD PORTABLE JDK 21
# =========================================================
if [ -z "$JAVA_HOME" ] || [ ! -d "$JAVA_HOME" ]; then
  if command -v java >/dev/null 2>&1; then
    REAL_JAVA=$(readlink -f "$(command -v java)" || true)
    if [ -n "$REAL_JAVA" ]; then
      JAVA_DIR=$(dirname "$(dirname "$REAL_JAVA")")
      if [ -d "$JAVA_DIR/bin" ]; then
        export JAVA_HOME="$JAVA_DIR"
        export PATH="$JAVA_HOME/bin:$PATH"
        echo "==> Auto-detected JAVA_HOME at $JAVA_HOME"
      fi
    fi
  fi
fi

if [ -z "$JAVA_HOME" ] || [ ! -d "$JAVA_HOME" ]; then
  JDK_DIR="$HOME/.m2/jdk-21"
  if [ ! -d "$JDK_DIR" ]; then
    echo "==> Downloading portable OpenJDK 21 for Render..."
    mkdir -p "$HOME/.m2"
    curl -sSL "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.3%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.3_9.tar.gz" | tar -xz -C "$HOME/.m2"
    EXTRACTED_DIR=$(find "$HOME/.m2" -maxdepth 1 -type d -name "jdk-21*" | head -n 1)
    if [ -n "$EXTRACTED_DIR" ]; then
      mv "$EXTRACTED_DIR" "$JDK_DIR"
    fi
  fi
  export JAVA_HOME="$JDK_DIR"
  export PATH="$JAVA_HOME/bin:$PATH"
  echo "==> Using portable JAVA_HOME at $JAVA_HOME"
fi

# =========================================================
# 2. DOWNLOAD PORTABLE MAVEN 3.9.6
# =========================================================
MAVEN_VERSION="3.9.6"
MAVEN_DIR="$HOME/.m2/apache-maven-$MAVEN_VERSION"

if [ ! -d "$MAVEN_DIR" ]; then
  echo "==> Downloading portable Maven $MAVEN_VERSION for Render build..."
  mkdir -p "$HOME/.m2"
  curl -sSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" | tar -xz -C "$HOME/.m2"
fi

# =========================================================
# 3. EXECUTE MAVEN BUILD
# =========================================================
if [ -f "backend/pom.xml" ]; then
  echo "==> Building Spring Boot backend from backend/pom.xml..."
  exec "$MAVEN_DIR/bin/mvn" -f backend/pom.xml "$@"
else
  echo "==> Building Spring Boot backend..."
  exec "$MAVEN_DIR/bin/mvn" "$@"
fi
