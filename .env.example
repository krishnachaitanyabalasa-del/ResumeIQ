# =========================================================
# RESUMEIQ ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (do NOT commit .env to git)
# =========================================================

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ResumeIQ?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ---------------------------------------------------------
# GOOGLE GEMINI MULTI-API KEY CONFIGURATION (ROTATION & FAILOVER)
# ---------------------------------------------------------
# Option A: Comma-separated list of Gemini API Keys
GOOGLE_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...

# Option B: Individual Gemini API Keys
GOOGLE_API_KEY1=AIzaSyKey1...
GOOGLE_API_KEY2=AIzaSyKey2...
GOOGLE_API_KEY3=AIzaSyKey3...
